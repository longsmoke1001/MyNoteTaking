# Copy to .env and fill in. Never commit the real .env.

# --- Translation (required for /api/translate) ---
AI_API_KEY=sk-or-v1-your-openrouter-key
AI_MODEL=nvidia/nemotron-3.5-lightning:free
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_APP_TITLE=NoteTaker
# AI_HTTP_REFERER=

# --- Database ---
# Leave DATABASE_URL unset to use the local SQLite file in database/app.db.
# Set it to a hosted PostgreSQL connection string (Neon, Supabase) for
# deployments, where the local filesystem is read-only and does not persist.
# Use the *pooled* connection string. Both postgres:// and postgresql:// work.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# DATABASE_PATH overrides the SQLite file location.
# DATABASE_PATH=database/app.db

# Set to 0 when the schema is managed by migrations instead of created at startup.
# AUTO_CREATE_TABLES=1
